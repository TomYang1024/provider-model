# 复制为 .env 使用（绝不要提交 .env）。没有密钥的 Provider 会被自动禁用。

# --- Provider API Key（或使用 *_FILE 指向 Docker Secret 文件）-----------------------------
DEEPSEEK_API_KEY=
# 也接受别名：ZHIPUAI_API_KEY、MOONSHOT_API_KEY、DASHSCOPE_API_KEY
GLM_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=
# 可选：覆盖 Base URL，例如 Qwen 国际站或工作空间域名：
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- 网关 -------------------------------------------------------------------------------
# 网关客户端使用的 Bearer 令牌，多个用逗号分隔（除非关闭认证，否则必填）
GATEWAY_API_KEYS=change-me-long-random-token
# GATEWAY_AUTH_DISABLED=false
GATEWAY_LOG_LEVEL=INFO
# 同时进行的模型调用上限，超出返回 503
GATEWAY_MAX_CONCURRENCY=256
# 非流式 / 流式请求的超时上限（秒）
GATEWAY_MAX_REQUEST_TIMEOUT=300
GATEWAY_MAX_STREAM_TIMEOUT=900
# SSE 保活 ping 间隔（秒）
GATEWAY_SSE_PING_INTERVAL=15
GATEWAY_ALLOW_PROVIDER_OPTIONS=true
# SIGTERM 后等待进行中请求的时间，以及 Telemetry Flush 超时（秒）
GATEWAY_SHUTDOWN_GRACE_SECONDS=20
GATEWAY_TELEMETRY_FLUSH_TIMEOUT=5
# 网关端口发布到宿主机的哪个网卡（设为 0.0.0.0 对外暴露）
GATEWAY_BIND=127.0.0.1

# --- SDK 输入输出日志 --------------------------------------------------------------------
# metadata_only（默认）| redacted | full（需同时设置 PROVIDER_SDK_ALLOW_FULL_LOGGING=true）
PROVIDER_SDK_LOG_MODE=metadata_only
PROVIDER_SDK_LOG_SAMPLE_RATE=1.0
PROVIDER_SDK_LOG_MAX_CHARS=2000
# PROVIDER_SDK_ALLOW_FULL_LOGGING=false
# 在 Span 上记录脱敏后的内容：
# PROVIDER_SDK_CAPTURE_CONTENT=false
# PROVIDER_SDK_CONFIG_FILE=/etc/provider-sdk/providers.toml

# --- OpenTelemetry（compose.yaml 已设置容器网络内的默认值）-------------------------------
# OTEL_SERVICE_NAME=provider-gateway
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
DEPLOY_ENV=production
